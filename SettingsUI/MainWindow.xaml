<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SettingsUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SettingsUI">

    <Grid Background="#202020">
        <ScrollViewer>
            <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                <Grid Background="#2B2B2B" Height="50" Margin="5,0,5,0" CornerRadius="3">
                    <TextBlock x:Uid="StartupText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" Margin="10,0,0,0" Foreground="White"></TextBlock>
                    <ToggleSwitch x:Name="Startup" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="1" Toggled="Startup_OnToggled"></ToggleSwitch>
                </Grid>
                <Grid Background="#2B2B2B" Height="50" Margin="5,5,5,0" CornerRadius="3">
                    <TextBlock x:Uid="AdminText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" Margin="10,0,0,15" Foreground="White"></TextBlock>
                    <TextBlock x:Uid="AdminRequiredText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" Margin="10,15,0,0" Foreground="LightGray"></TextBlock>
                    <ToggleSwitch x:Name="Admin" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="1" IsEnabled="False" Toggled="Admin_OnToggled"></ToggleSwitch>
                </Grid>
                <Grid Background="#2B2B2B" Height="50" Margin="5,5,5,0" CornerRadius="3">
                    <TextBlock x:Uid="ModeText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" Margin="10,0,0,0" Foreground="White"></TextBlock>
                    <ComboBox x:Name="Mode" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" SelectedIndex="-1" SelectionChanged="Mode_OnSelectionChanged">
                        <ComboBox.Items>
                            <ComboBoxItem x:Uid="ModeWindow">Window</ComboBoxItem>
                            <ComboBoxItem x:Uid="ModeScreen">Screen</ComboBoxItem>
                        </ComboBox.Items>
                    </ComboBox>
                </Grid>
                <Grid Background="#2B2B2B" Height="50" Margin="5,5,5,0" CornerRadius="3">
                    <TextBlock x:Uid="ShortcutKeyText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" Margin="10,0,0,0" Foreground="White"></TextBlock>
                    <ComboBox x:Name="ShortcutKey" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" SelectedIndex="-1" SelectionChanged="ShortcutKey_OnSelectionChanged"></ComboBox>
                </Grid>
                <Grid Background="#2B2B2B" Height="50" Margin="5,5,5,0" CornerRadius="3">
                    <TextBlock x:Uid="MethodText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" Margin="10,0,0,0" Foreground="White"></TextBlock>
                    <ComboBox x:Name="Method" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" SelectedIndex="-1" SelectionChanged="Method_OnSelectionChanged">
                        <ComboBox.Items>
                            <x:String>BitBlt</x:String>
                            <x:String>PrintWindow</x:String>
                            <x:String>DirectX</x:String>
                        </ComboBox.Items>
                    </ComboBox>
                </Grid>
                <Button x:Name="Apply" x:Uid="ApplyButton" Background="#2B2B2B" HorizontalAlignment="Stretch" Height="50" Margin="5,10,5,0" Click="Apply_OnClick"></Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
